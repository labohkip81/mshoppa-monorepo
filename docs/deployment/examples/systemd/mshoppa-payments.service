# TEMPLATE: application production prerequisites in DEPLOYMENT.md must be completed.
[Unit]
Description=MSHOPPA payments
After=network-online.target
Wants=network-online.target

[Service]
User=mshoppa
Group=mshoppa
WorkingDirectory=/srv/mshoppa/current/services/payments
EnvironmentFile=/etc/mshoppa/core.env
EnvironmentFile=/etc/mshoppa/payments.env
Environment=PYTHONPATH=/srv/mshoppa/current/services/core
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/srv/mshoppa/current/services/core/.venv/bin/gunicorn --bind 127.0.0.1:8001 --workers 1 --threads 2 --timeout 60 --error-logfile - payment_config.wsgi:application
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/mshoppa/shared

[Install]
WantedBy=multi-user.target
