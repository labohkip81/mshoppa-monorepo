{
  "name": "mshoppa",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev:all": "node scripts/dev.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "dev": "ng serve merchant-admin --port 4201",
    "dev:marketing": "ng serve marketing --port 4200",
    "dev:platform": "ng serve platform-admin --port 4202",
    "dev:storefront": "ng serve storefront --port 4203",
    "dev:payments": "ng serve payments --port 4204",
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "api:generate": "openapi-typescript docs/architecture/openapi.yaml -o packages/api-client/src/schema.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@angular/animations": "^21.2.0",
    "@angular/cdk": "^21.0.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@spartan-ng/brain": "1.4.1",
    "clsx": "^2.1.1",
    "luxon": "^3.7.0",
    "quill": "^2.0.3",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "openapi-typescript": "^7.10.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3"
  }
}
