# Copy to services/payments/.env; dev:all reads this file for the payment API only.
# These are private MSHOPPA defaults; stores may override them in admin.
# Restart dev:all after changing settings. Never commit real keys.
STRIPE_PAYMENT_BACKEND=stripe
# Hosted Checkout requires the secret key; a publishable key alone is insufficient.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MPESA_PAYMENT_BACKEND=venty
VENTY_MPESA_BASE_URL=https://mpesa.venti.africa/mpesa/api/v1

# To use Venty’s default account: enabled=1, tenant_id=default, use_default_config=1.
VENTY_MPESA_ENABLED=0
VENTY_MPESA_TENANT_ID=
VENTY_MPESA_USE_DEFAULT_CONFIG=0
VENTY_MPESA_API_TOKEN=
# Optional publicly reachable callback forwarding to /api/webhooks/venty/mpesa/.
# The secret must match Venty's PAYMENT_CALLBACK_SECRET deployment setting.
VENTY_MPESA_CALLBACK_URL=
VENTY_MPESA_CALLBACK_SECRET=
# Offline testing: set both *_PAYMENT_BACKEND values to simulator instead.
